{
  "mcpServers": {
    "postgres-dev": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "DATABASE_URI",
        "crystaldba/postgres-mcp",
        "--access-mode=unrestricted"
      ],
      "env": {
        "DATABASE_URI": "postgresql://dev_user:dev_password@localhost:5432/dev_db"
      }
    }
  }
}
