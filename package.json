{
  "name": "notes-server",
  "version": "1.0.0",
  "description": "Koa server for notes application",
  "main": "./src/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon ./src/index.js",
    "start": "node ./src/index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "docker": "docker compose -f ./server/docker/docker-compose.dev.yml up -d",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
